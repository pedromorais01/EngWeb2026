extends layout

block content
  .w3-container.w3-margin
    .w3-card-4
      header.w3-container.w3-teal
        h2= actor.name
      .w3-container
        p 
          b ID: 
          span= actor._id
        if actor.movies && actor.movies.length > 0
          h3 Filmografia
          ul.w3-ul
            each movie in actor.movies
              li
                a(href="/filmes/" + movie._id)= movie.title
      footer.w3-container.w3-teal.w3-margin-top
        address
          a(href="/atores") Voltar à lista
