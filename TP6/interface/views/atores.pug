extends layout

block content
  .w3-container
    h2 Lista de Atores (#{list.length})
    table.w3-table-all
      tr.w3-teal
        th Id
        th Nome
        th # Filmes
      each a in list
        tr
          td= a._id
          td
            a(href="/atores/" + a._id)= a.name
          td= a.movies ? a.movies.length : 0
