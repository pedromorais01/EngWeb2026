extends layout

block content
  .w3-container
    h2 Lista de Filmes (#{list.length})
    table.w3-table-all
      tr.w3-teal
        th Id
        th Título
        th Ano
        th # Atores
        th # Géneros
      each f in list
        tr
          td= f._id
          td
            a(href="/filmes/" + f._id)= f.title
          td= f.year
          td= f.cast ? f.cast.length : 0
          td= f.genres ? f.genres.length : 0
