extends layout

block content
  .w3-container.w3-margin
    .w3-card-4
      header.w3-container.w3-teal
        h2 Género: #{genre.name}
      .w3-container
        p 
          b ID: 
          span= genre._id
        if genre.movies && genre.movies.length > 0
          h3 Filmes Associados
          ul.w3-ul
            each movie in genre.movies
              li
                a(href="/filmes/" + movie._id)= movie.title
      footer.w3-container.w3-teal.w3-margin-top
        address
          a(href="/generos") Voltar à lista
